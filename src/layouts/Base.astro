---
import fs from "node:fs";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { PROFILE, ORG, SITE, FOOTER, socialLinks, sameAs } from "../siteData";

/* Read at build time, inlined into <head> — see the note beside the <style>
   tag below. Kept as a file so the admin/font tooling still has one source. */
const FONT_CSS = fs.readFileSync("public/fonts/fonts.css", "utf8");
const CF_ANALYTICS_TOKEN = SITE.analytics.cloudflareToken;
const GOOGLE_SITE_VERIFICATION = SITE.analytics.googleSiteVerification;

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  article?: Record<string, unknown> | Record<string, unknown>[] | null;
  noindex?: boolean;
  keywords?: string[];
}
const {
  title,
  description = "Practical marketing frameworks and real lessons from Prabhash Jha — Co-Founder of ADVOLT, a performance marketing agency working with streaming, e-commerce, D2C and BFSI brands across India and South East Asia.",
  image,
  type = "website",
  publishedTime,
  article = null,
  noindex = false,
  keywords = [],
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://www.prabhashjha.com").toString();

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.prabhashjha.com/#prabhash",
      name: PROFILE.name, givenName: PROFILE.name.split(" ")[0], familyName: PROFILE.name.split(" ").slice(1).join(" "),
      jobTitle: PROFILE.jobTitle,
      description: PROFILE.bio,
      url: "https://www.prabhashjha.com",
      mainEntityOfPage: "https://www.prabhashjha.com/about",
      worksFor: { "@id": "https://www.prabhashjha.com/#advolt" },
      homeLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: PROFILE.locality, addressRegion: PROFILE.region, addressCountry: PROFILE.country } },
      knowsAbout: PROFILE.knowsAbout.split(",").map((k) => k.trim()).filter(Boolean),
      sameAs: sameAs(),
    },
    { "@type": "Organization", "@id": "https://www.prabhashjha.com/#advolt", name: ORG.name,
      description: ORG.description,
      url: "https://www.prabhashjha.com", founder: { "@id": "https://www.prabhashjha.com/#prabhash" } },
    { "@type": "WebSite", "@id": "https://www.prabhashjha.com/#website", name: PROFILE.name,
      url: "https://www.prabhashjha.com", publisher: { "@id": "https://www.prabhashjha.com/#prabhash" },
      inLanguage: "en",
      potentialAction: { "@type": "SearchAction",
        target: { "@type": "EntryPoint", urlTemplate: "https://www.prabhashjha.com/search?q={search_term_string}" },
        "query-input": "required name=search_term_string" } },
    ...(article ? (Array.isArray(article) ? article : [article]) : []),
  ],
};

const nav = [
  { href: "/blog", label: "Topics" },
  { href: "/about", label: "About" },
  { href: "/work-with-me", label: "Work With Me" },
  { href: "/newsletter", label: "Newsletter" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Matches --color-void in each theme, so the browser chrome on mobile
        continues the page rather than framing it in a leftover blue-black. */}
    <meta name="theme-color" content="#F4F3EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F0D" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Prabhash Jha" href="/rss.xml" />
    {/* Self-hosted: Newsreader (display + body) and IBM Plex Mono (labels,
        figures), latin subset only. No CDN request, nothing from a third party.

        These rules are inlined rather than linked. As a separate stylesheet
        they were a render-blocking request that had to be fetched before the
        browser even learned which font files it needed — a whole round trip
        in front of the Largest Contentful Paint, for 722 bytes. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/cY9AfjOCX1hbuyalUrK4397yjIJFJpc.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/-F63fjptAgt5VM-kVkqdyU8n1i8q131nj-o.woff2" />
    <style is:inline set:html={FONT_CSS} />
    {/* .reveal elements start hidden so there is no flash of unstyled content.
        If the motion chunk never arrives — a bad deploy, a blocked request, a
        browser that gives up — that hidden state would leave a blank page. This
        timer is the guarantee that it can't: motion.ts stamps data-motion on
        the root as its first act, and anything else forces the page visible. */}
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(function () {
        var r = document.documentElement;
        if (!r.dataset.motion) r.classList.add("motion-failed");
      }, 2500);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ClientRouter />
  </head>

  <body class="noise">
    <div id="progress"></div>

    <header data-pagefind-ignore id="siteHeader" class="fixed top-0 inset-x-0 z-50" transition:persist>
      <div id="headerInner" class="mx-auto max-w-6xl px-5 sm:px-8 flex items-center justify-between h-[74px] transition-[height] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span class="w-[20px] h-[20px] rounded-[6px] bg-accent transition-transform duration-200 group-hover:rotate-[135deg]"></span>
          <span class="font-display font-bold tracking-tight text-[1.02rem]" set:html={PROFILE.name.replace(" ", "&nbsp;")} />
        </a>
        <nav class="hidden md:flex items-center gap-8 text-[0.88rem]">
          {nav.map((n) => (
            <a href={n.href} class:list={["relative transition-colors duration-200 hover:text-text",
              path === n.href || (n.href !== "/" && path.startsWith(n.href)) ? "text-text" : "text-muted"]}>
              {n.label}
              {(path === n.href || (n.href !== "/" && path.startsWith(n.href))) && (
                <span class="absolute -bottom-1.5 left-0 right-0 h-[1.5px] bg-accent" />
              )}
            </a>
          ))}
          <a href="/search" aria-label="Search" title="Search"
            class="grid place-items-center w-9 h-9 border border-hair text-muted hover:text-text hover:border-accent transition-colors duration-200">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
            </svg>
          </a>
        </nav>
        <button id="navToggle" class="md:hidden w-10 h-10 -mr-2 grid place-items-center" aria-label="Menu" aria-expanded="false">
          <span class="block w-6 h-[2px] bg-text relative before:content-[''] before:absolute before:w-6 before:h-[2px] before:bg-text before:-top-2 after:content-[''] after:absolute after:w-6 after:h-[2px] after:bg-text after:top-2"></span>
        </button>
      </div>
      <div id="mobileNav" class="md:hidden hidden border-t border-hair">
        <nav class="px-5 py-4 flex flex-col">
          {nav.map((n) => <a href={n.href} class="py-3 text-[1.05rem] border-b border-hair last:border-0">{n.label}</a>)}
          <a href="/search" class="py-3 text-[1.05rem]">Search</a>
        </nav>
      </div>
    </header>

    <main id="main" class="pt-[74px] relative z-[2]"><slot /></main>

    <footer data-pagefind-ignore class="relative z-[2] mt-10 border-t border-hair bg-surface">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 py-16">
        <div class="flex flex-col md:flex-row justify-between gap-12">
          <div class="max-w-sm">
            <div class="flex items-center gap-2.5 mb-4">
              <span class="w-[20px] h-[20px] rounded-[6px] bg-accent"></span>
              <span class="font-display font-bold tracking-tight">{PROFILE.name}</span>
            </div>
            <p class="text-[0.94rem] text-muted leading-relaxed">
              {FOOTER.blurb}
            </p>
          </div>
          <div class="flex gap-14 text-[0.9rem]">
            <div>
              <p class="font-mono text-[0.7rem] tracking-widest uppercase text-dim mb-4">Explore</p>
              <ul class="space-y-1 text-muted">
                <li><a class="inline-block py-1.5 hover:text-text transition-colors" href="/blog">Topics</a></li>
                <li><a class="inline-block py-1.5 hover:text-text transition-colors" href="/about">About</a></li>
                <li><a class="inline-block py-1.5 hover:text-text transition-colors" href="/work-with-me">Work With Me</a></li>
                <li><a class="inline-block py-1.5 hover:text-text transition-colors" href="/newsletter">Newsletter</a></li>
              </ul>
            </div>
            <div>
              <p class="font-mono text-[0.7rem] tracking-widest uppercase text-dim mb-4">Elsewhere</p>
              <ul class="space-y-1 text-muted">
                {socialLinks().map((s) => (
                  <li><a class="inline-block py-1.5 hover:text-text transition-colors" href={s.url} rel="me">{s.label}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <p class="mt-14 pt-6 border-t border-hair text-[0.82rem] text-dim font-mono">
          © {new Date().getFullYear()} {PROFILE.name.toUpperCase()} · {FOOTER.copyrightSuffix}
          <a class="ml-3 inline-block py-1.5 hover:text-text transition-colors" href="/privacy">PRIVACY</a>
        </p>
      </div>
    </footer>

    <script>
      import "../motion";
    </script>
    {CF_ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      />
    )}
  </body>
</html>
