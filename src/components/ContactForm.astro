---
/* Zero-cost contact form.

   Posts to Web3Forms (free, unlimited submissions, no server, no database —
   the message lands in your email inbox, so it costs you no storage).
   Until an access key is set in Settings the form degrades gracefully to a
   mailto: link or a LinkedIn link, so this block always gives people a route
   to you and never renders as a dead end. */
import { CONTACT, contactAction, contactMailto, SOCIAL } from "../siteData";
const action = contactAction();
const mailto = contactMailto();
const subject = "Enquiry from prabhashjha.com";
---

<div class="reveal glass rounded-2xl p-8 md:p-10 relative overflow-hidden" id="contact">
  <div class="orb orb-a w-[20rem] h-[20rem] bg-cyan/15 -bottom-24 -right-16"></div>
  <div class="relative">
    <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-cyan mb-4">/ Get in touch</p>
    <h2 class="font-display font-bold text-[1.6rem] sm:text-[2rem] leading-tight mb-3">
      {CONTACT.formHeading}
    </h2>
    <p class="text-muted leading-relaxed mb-8 max-w-lg">{CONTACT.formBlurb}</p>

    {action ? (
      <form id="contactForm" action={action} method="POST" class="grid gap-3 sm:grid-cols-2 max-w-2xl">
        <input type="hidden" name="access_key" value={CONTACT.formAccessKey} />
        <input type="hidden" name="subject" value={subject} />
        <input type="hidden" name="from_name" value="prabhashjha.com" />
        {/* Honeypot: bots fill it, humans never see it. Keeps spam out of your inbox. */}
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <label class="block">
          <span class="sr-only">Your name</span>
          <input name="name" type="text" required placeholder="Your name" autocomplete="name"
            class="w-full glass rounded-xl px-5 py-3.5 text-text placeholder:text-dim outline-none focus:border-cyan transition-colors" />
        </label>
        <label class="block">
          <span class="sr-only">Your email</span>
          <input name="email" type="email" required placeholder="you@company.com" autocomplete="email"
            class="w-full glass rounded-xl px-5 py-3.5 text-text placeholder:text-dim outline-none focus:border-cyan transition-colors" />
        </label>
        <label class="block sm:col-span-2">
          <span class="sr-only">Message</span>
          <textarea name="message" required rows="4" placeholder="What are you working on?"
            class="w-full glass rounded-xl px-5 py-3.5 text-text placeholder:text-dim outline-none focus:border-cyan transition-colors resize-y"></textarea>
        </label>
        <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
          <button type="submit"
            class="group relative inline-flex items-center gap-2 rounded-full px-8 py-3.5 font-medium text-white overflow-hidden transition-transform duration-500 hover:-translate-y-0.5">
            <span class="absolute inset-0 bg-gradient-to-r from-blue via-violet to-cyan"></span>
            <span class="relative">{CONTACT.formButtonLabel}</span>
          </button>
          <p id="contactMsg" class="font-mono text-[0.68rem] tracking-widest uppercase text-dim" role="status" aria-live="polite">
            Goes straight to my inbox
          </p>
        </div>
      </form>
    ) : (
      <div class="flex flex-wrap gap-3">
        {mailto && (
          <a href={`${mailto}?subject=${encodeURIComponent(subject)}`}
            class="group relative inline-flex items-center gap-2 rounded-full px-8 py-3.5 font-medium text-white overflow-hidden transition-transform duration-500 hover:-translate-y-0.5">
            <span class="absolute inset-0 bg-gradient-to-r from-blue via-violet to-cyan"></span>
            <span class="relative">Email me</span>
          </a>
        )}
        <a href={SOCIAL.linkedin}
          class="glass glow-hover rounded-full px-8 py-3.5 text-text/90 hover:text-text">{mailto ? "Or message me on LinkedIn" : "Message me on LinkedIn"}</a>
      </div>
    )}
  </div>
</div>

<script is:inline>
  // Submit in the background so people stay on the page instead of being
  // bounced to a third-party "thanks" screen.
  (() => {
    const boot = () => {
      const f = document.getElementById("contactForm");
      if (!f || f.dataset.wired) return;
      f.dataset.wired = "1";
      const msg = document.getElementById("contactMsg");
      f.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = f.querySelector("button[type=submit]");
        if (btn) btn.disabled = true;
        if (msg) msg.textContent = "Sending…";
        try {
          const r = await fetch(f.action, { method: "POST", body: new FormData(f) });
          if (!r.ok) throw new Error(String(r.status));
          f.reset();
          if (msg) msg.textContent = "Thanks — I'll come back to you.";
        } catch {
          if (msg) msg.textContent = "Didn't send. Please email or message me on LinkedIn.";
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    };
    boot();
    document.addEventListener("astro:page-load", boot);
  })();
</script>
