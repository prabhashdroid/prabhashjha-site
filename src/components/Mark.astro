---
/* The site mark.
 *
 * The old logo was a plain filled square — a placeholder, not a mark. This is
 * built from the same vocabulary as everything else here: a ruled cell with
 * one entry marked. That is literally what the site is about — the one line in
 * the ledger that decides whether the whole thing made money.
 *
 * Drawn on a 24 grid with stroke weights that survive being rendered at 22px.
 */
interface Props { size?: number; class?: string }
const { size = 22, class: cls = "" } = Astro.props as Props;
---
<svg
  class:list={["site-mark", cls]}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" aria-hidden="true"
>
  <rect x="1.6" y="1.6" width="20.8" height="20.8" stroke="currentColor" stroke-width="2.2" />
  <line x1="1.6" y1="9.4" x2="22.4" y2="9.4" stroke="currentColor" stroke-width="1.6" />
  <line x1="9.4" y1="9.4" x2="9.4" y2="22.4" stroke="currentColor" stroke-width="1.6" />
  {/* the marked cell — the one figure that matters */}
  <rect x="9.4" y="1.6" width="13" height="7.8" fill="var(--color-accent)" />
</svg>
