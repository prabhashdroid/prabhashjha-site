---
import { coverSize } from "../seo";
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { catSlug, CATEGORY_BLURBS, CATEGORY_ORDER } from "../categories";
import { HOME } from "../siteData";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft && (p.data.slug ?? p.id) !== "privacy-policy")
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const lead = posts[0];
const latest = posts.slice(1, 5);

const cats = [...new Set(posts.map((p) => p.data.category))];
const order = CATEGORY_ORDER;
const topics = order.filter((c) => cats.includes(c)).map((c) => ({
  name: c,
  href: `/blog/categories/${catSlug(c)}`,
  blurb: CATEGORY_BLURBS[c] ?? "",
  count: posts.filter((p) => p.data.category === c).length,
}));

const ticker = ["LTV : CAC", "PAYBACK PERIOD", "BREAK-EVEN ROAS", "CONTRIBUTION MARGIN",
  "RETENTION", "PROGRAMMATIC", "ATTRIBUTION", "CREATIVE TESTING", "UNIT ECONOMICS"];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const words = posts.reduce((s, p) => s + (p.body?.split(/\s+/).length ?? 0), 0);
---

<Base title="Prabhash Jha — Practical Marketing & Founder Playbooks">
  <!-- ================= HERO =================
       A masthead, not a product hero: label, statement, standfirst, then a
       colophon row of figures. Hairline rules carry the structure. -->
  <section class="relative" data-hero>
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-20 pb-16 md:pt-28 md:pb-20">
      <p class="reveal label flex items-center gap-3 mb-8">
        <span class="w-8 h-px bg-accent" aria-hidden="true"></span>{HOME.badge}
      </p>

      <h1 data-words class="font-display font-semibold text-[2.6rem] leading-[1.03] sm:text-6xl lg:text-[4.6rem] max-w-[16ch]">
        {HOME.headline}
        <span class="grad-text">{HOME.headlineAccent}</span>.
      </h1>

      <p class="reveal mt-8 max-w-[46ch] text-[1.12rem] leading-relaxed text-muted">
        {HOME.intro}
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={HOME.primaryCtaHref} data-magnetic
          class="group inline-flex items-center gap-2.5 px-7 py-3.5 font-medium bg-accent text-void border border-accent transition-colors duration-200 hover:bg-transparent hover:text-accent">
          {HOME.primaryCtaLabel}
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
        <a href={HOME.secondaryCtaHref}
          class="link-sweep text-[0.95rem] text-muted pb-0.5">
          {HOME.secondaryCtaLabel}
        </a>
      </div>
    </div>

    <!-- colophon: the three figures that describe the archive -->
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <dl class="reveal grid grid-cols-3 border-t border-hair">
        {[
          { v: posts.length, l: "Guides published", suffix: "" },
          { v: Math.round(words / 1000), l: "Words published", suffix: "k" },
          { v: HOME.yearsInField, l: "Years in the field", suffix: "+" },
        ].map((s, i) => (
          <div class:list={["py-6 pr-4", i > 0 && "pl-4 sm:pl-8 border-l border-hair"]}>
            <dt class="label mb-2">{s.l}</dt>
            <dd class="font-display font-semibold text-[2rem] sm:text-[2.6rem] leading-none tabular">
              <span data-count={s.v}>0</span>{s.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- ticker: the vocabulary of the work -->
    <div class="relative border-y border-hair py-3.5 overflow-hidden">
      <div class="marquee label">
        {[...ticker, ...ticker].map((t) => (
          <span class="flex items-center gap-3 whitespace-nowrap">
            <span class="w-1 h-1 bg-accent" aria-hidden="true"></span>{t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= LEAD STORY ================= -->
  {lead && (
    <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-16 md:pt-24">
      <a href={`/post/${lead.data.slug ?? lead.id}`}
        class="reveal group grid lg:grid-cols-[1.05fr_1fr] gap-8 lg:gap-14 items-center">
        {lead.data.cover && (
          <div data-parallax data-tilt class="frame border border-hair order-1 lg:order-2">
            <img src={lead.data.cover} alt="" loading="lazy" transition:name={`cover-${lead.data.slug ?? lead.id}`}
              width={coverSize(lead.data).width} height={coverSize(lead.data).height}
              class="w-full aspect-[16/10] object-cover" />
          </div>
        )}
        <div class="order-2 lg:order-1">
          <p class="label mb-4">Latest &nbsp;/&nbsp; {lead.data.category}</p>
          <h2 class="shift font-display font-semibold text-[1.9rem] sm:text-[2.5rem] leading-[1.08] text-balance
                     group-hover:text-accent">
            {lead.data.title}
          </h2>
          <p class="mt-5 text-[1.02rem] text-muted leading-relaxed max-w-[52ch]">{lead.data.description}</p>
          <p class="mt-6 label"><time datetime={String(lead.data.pubDate)}>{fmt(lead.data.pubDate)}</time></p>
        </div>
      </a>
    </section>
  )}

  <!-- ================= TOPICS =================
       A contents page. The count is the only figure that carries meaning,
       so it is the only thing set as a figure. -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-20 md:pt-28">
    <div class="reveal flex items-end justify-between gap-6 mb-10 pb-5 border-b border-hair">
      <h2 data-words class="font-display font-semibold text-[1.9rem] sm:text-[2.5rem] leading-none">
        Pick a track and go deep.
      </h2>
      <p class="label hidden sm:block shrink-0 pb-1">{topics.length} tracks</p>
    </div>

    <div>
      {topics.map((t) => (
        <a href={t.href}
          class="reveal rule-draw group grid grid-cols-[1fr_auto] sm:grid-cols-[minmax(0,15rem)_1fr_auto] items-baseline
                 gap-x-6 gap-y-1.5 border-b border-hair py-6 transition-colors duration-200 hover:bg-surface">
          <h3 class="shift font-display font-semibold text-[1.22rem] leading-snug group-hover:text-accent">
            {t.name}
          </h3>
          <p class="col-span-2 sm:col-span-1 text-[0.95rem] text-muted leading-relaxed max-w-[60ch] order-last sm:order-none">
            {t.blurb}
          </p>
          <p class="label tabular self-baseline text-right">{t.count}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ================= FREE TOOL ================= -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal border-b border-hair py-16 md:py-24 md:flex md:items-end md:justify-between gap-14">
      <div class="max-w-[46ch]">
        <p class="label mb-5">/ {HOME.featureLabel}</p>
        <h2 class="font-display font-semibold text-[1.9rem] sm:text-[2.5rem] leading-[1.08]">
          {HOME.featureHeading}
        </h2>
        <p class="mt-5 text-muted leading-relaxed">
          {HOME.featureBlurb}
        </p>
      </div>
      <a href={HOME.featureCtaHref} data-magnetic
        class="group mt-9 md:mt-0 shrink-0 inline-flex items-center gap-2.5 px-7 py-3.5 font-medium bg-accent text-void border border-accent transition-colors duration-200 hover:bg-transparent hover:text-accent">
        {HOME.featureCtaLabel}
        <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- ================= LATEST ================= -->
  <section class="mx-auto max-w-6xl px-5 sm:px-8 py-20 md:py-28">
    <div class="reveal flex items-end justify-between gap-6 mb-10 pb-5 border-b border-hair">
      <h2 class="font-display font-semibold text-[1.9rem] sm:text-[2.5rem] leading-none">More from the desk</h2>
      <a href="/blog" class="shrink-0 label pb-1 hover:text-accent transition-colors duration-200">All posts &rarr;</a>
    </div>

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {latest.map((p) => (
        <a href={`/post/${p.data.slug ?? p.id}`} class="reveal group block">
          {p.data.cover && (
            <div class="frame border border-hair mb-4">
              <img src={p.data.cover} alt="" loading="lazy" transition:name={`cover-${p.data.slug ?? p.id}`}
                width={coverSize(p.data).width} height={coverSize(p.data).height}
                class="w-full aspect-[4/3] object-cover" />
            </div>
          )}
          <p class="label mb-2.5"><time datetime={String(p.data.pubDate)}>{fmt(p.data.pubDate)}</time></p>
          <h3 class="font-display font-semibold text-[1.14rem] leading-snug text-balance transition-colors duration-200 group-hover:text-accent">
            {p.data.title}
          </h3>
          <p class="mt-2 text-[0.92rem] text-muted leading-relaxed line-clamp-2">{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
