---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { getEntry } from "astro:content";
const page = await getEntry("pages", "work-with-me");
const d = page!.data;
---
<Base title={d.title} description={d.description}>
  <section class="relative">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-5 sm:px-8 pt-20 pb-14 md:pt-28">
      <p class="reveal label mb-6">/ {d.eyebrow}</p>
      <h1 data-words class="font-display font-semibold text-[2.6rem] sm:text-[3.6rem] leading-[1.03] max-w-[16ch]">
        {d.heading} <span class="grad-text">{d.headingAccent}</span>.
      </h1>
      <p class="reveal mt-7 text-muted max-w-[50ch] text-[1.05rem] leading-relaxed">
        {d.intro}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 sm:px-8 pb-20">
    {/* A menu, not a process — so the rows are ruled, not numbered. */}
    <div class="border-t border-hair">
      {d.services.map((s: { title: string; blurb: string }) => (
        <div class="reveal grid sm:grid-cols-[minmax(0,16rem)_1fr] gap-x-8 gap-y-2 border-b border-hair py-7">
          <h2 class="font-display font-semibold text-[1.22rem] leading-snug">{s.title}</h2>
          <p class="text-[0.96rem] text-muted leading-relaxed max-w-[60ch]">{s.blurb}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-16 md:flex md:items-end md:justify-between gap-12">
      <div class="max-w-[46ch]">
        <h2 class="font-display font-semibold text-[1.7rem] sm:text-[2.2rem] leading-tight">
          {d.ctaHeading}
        </h2>
        <p class="mt-4 text-muted leading-relaxed">
          {d.ctaText}
        </p>
      </div>
      <a href={d.ctaHref}
        class="group mt-8 md:mt-0 shrink-0 inline-flex items-center gap-2.5 px-7 py-3.5 font-medium bg-accent text-void border border-accent transition-colors duration-200 hover:bg-transparent hover:text-accent">
        {d.ctaLabel}
        <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 sm:px-8 pb-24">
    <ContactForm />
  </section>
</Base>
