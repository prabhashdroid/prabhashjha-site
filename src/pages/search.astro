---
import Base from "../layouts/Base.astro";
---

<Base
  title="Search — Prabhash Jha"
  description="Search every guide, framework and playbook on prabhashjha.com."
  noindex={true}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="orb orb-a w-[30rem] h-[30rem] bg-blue/20 -top-40 -left-24"></div>
    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pt-28 pb-20 md:pt-36">
      <p class="reveal font-mono text-[0.7rem] tracking-[0.2em] uppercase text-dim mb-5">/ Search</p>
      <h1 data-words class="font-display font-bold text-[2.4rem] sm:text-5xl">
        Find <span class="grad-text">anything</span>.
      </h1>
      <p class="reveal mt-5 text-muted">
        Every guide on this site, searchable instantly. No server, no tracking.
      </p>
      <div id="search" class="reveal mt-12"></div>
      <noscript>
        <p class="mt-8 text-muted">
          Search needs JavaScript. <a href="/blog" class="text-cyan">Browse all posts instead →</a>
        </p>
      </noscript>
    </div>
  </section>
</Base>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof PagefindUI === "undefined") return;
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      pageSize: 8,
      resetStyles: false,
      translations: { placeholder: "Search guides, frameworks, playbooks…" },
    });
    const input = document.querySelector(".pagefind-ui__search-input");
    if (input) input.focus();
    // deep-link support: /search?q=roas
    const q = new URLSearchParams(location.search).get("q");
    if (q && input) {
      input.value = q;
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
  });
</script>

<style is:global>
  /* Pagefind ships light-theme defaults; retint it for the dark palette. */
  #search {
    --pagefind-ui-primary: var(--color-text);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--color-hair);
    --pagefind-ui-tag: var(--color-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__search-input {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text);
    font-size: 1rem;
    padding: 1rem 1.1rem;
  }
  #search .pagefind-ui__search-input::placeholder { color: var(--color-dim); }
  #search .pagefind-ui__search-input:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }
  #search .pagefind-ui__search-clear { background: transparent; color: var(--color-muted); }
  #search .pagefind-ui__result {
    border-top: 1px solid var(--color-hair);
    padding: 1.6rem 0;
  }
  #search .pagefind-ui__result-title a {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
  }
  #search .pagefind-ui__result-title a:hover { color: var(--color-cyan); }
  #search .pagefind-ui__result-excerpt { color: var(--color-muted); font-size: 0.94rem; }
  #search .pagefind-ui__result-excerpt mark {
    background: transparent;
    color: var(--color-cyan);
    font-weight: 600;
  }
  #search .pagefind-ui__message { color: var(--color-muted); font-size: 0.9rem; }
  #search .pagefind-ui__button {
    background: transparent;
    border: 1px solid var(--color-hair);
    color: var(--color-text);
    border-radius: 9999px;
  }
</style>
