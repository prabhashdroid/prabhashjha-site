---
import { coverSize, metaDescription, extractFaqs } from "../../seo";
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import { catSlug } from "../../categories";
import { keywordsFor, overlap } from "../../keywords";
import { TOPICS } from "../../siteData";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"posts"> };
const { post } = Astro.props as Props;
const { Content } = await render(post);

// Keywords are derived at build time from the Topic + the post itself.
// Nobody types them in. See src/keywords.ts.
const topicSeeds = (c: string) =>
  ((TOPICS.find((t: any) => t.name === c) as any)?.keywords ?? []) as string[];
const keywords = keywordsFor({
  title: post.data.title, description: post.data.description,
  body: post.body, category: post.data.category, topicKeywords: topicSeeds(post.data.category),
});

// Related = strongest keyword overlap, with same-topic posts preferred.
// This builds real internal links between articles that share subject matter.
const pool = (await getCollection("posts"))
  .filter((p) => !p.data.draft && (p.data.slug ?? p.id) !== (post.data.slug ?? post.id) && (p.data.slug ?? p.id) !== "privacy-policy");
const scored = pool
  .map((p) => ({
    p,
    s:
      overlap(keywords, keywordsFor({
        title: p.data.title, description: p.data.description, body: p.body,
        category: p.data.category, topicKeywords: topicSeeds(p.data.category),
      })) + (p.data.category === post.data.category ? 3 : 0),
    d: +new Date(p.data.pubDate),
  }))
  .sort((a, b) => b.s - a.s || b.d - a.d);
const all = scored.slice(0, 3).map((x) => x.p);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const words = post.body ? post.body.split(/\s+/).length : 0;
const canonicalUrl = `https://www.prabhashjha.com/post/${post.data.slug ?? post.id}/`;
const faqs = extractFaqs(post.body);
const faqSchema = faqs.length
  ? {
      "@type": "FAQPage",
      "@id": canonicalUrl + "#faq",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const articleSchema = {
  "@type": "BlogPosting",
  "@id": canonicalUrl + "#article",
  headline: post.data.title,
  description: metaDescription(post.data.description, post.body),
  datePublished: post.data.pubDate,
  dateModified: post.data.pubDate,
  articleSection: post.data.category,
  keywords: keywords.join(", "),
  about: keywords.slice(0, 6).map((k) => ({ "@type": "Thing", name: k })),
  wordCount: words,
  inLanguage: "en",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  author: { "@id": "https://www.prabhashjha.com/#prabhash" },
  publisher: { "@id": "https://www.prabhashjha.com/#prabhash" },
  isPartOf: { "@id": "https://www.prabhashjha.com/#website" },
  ...(post.data.cover ? { image: "https://www.prabhashjha.com" + post.data.cover } : {}),
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.prabhashjha.com/" },
      { "@type": "ListItem", position: 2, name: "Topics", item: "https://www.prabhashjha.com/blog/" },
      { "@type": "ListItem", position: 3, name: post.data.category,
        item: `https://www.prabhashjha.com/blog/categories/${catSlug(post.data.category)}/` },
      { "@type": "ListItem", position: 4, name: post.data.title, item: canonicalUrl },
    ],
  },
};
const mins = Math.max(1, Math.round(words / 220));
---

<Base
  title={post.data.title}
  description={metaDescription(post.data.description, post.body)}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.pubDate}
  article={faqSchema ? [articleSchema, faqSchema] : [articleSchema]}
  keywords={keywords}
>
  <article data-pagefind-body>
    <header class="mx-auto max-w-3xl px-5 sm:px-8 pt-16 md:pt-24" data-hero>
      <nav data-pagefind-ignore aria-label="Breadcrumb" class="reveal step-1 label flex flex-wrap items-center gap-2 mb-7">
        <a href="/blog" class="hover:text-accent transition-colors duration-200">Topics</a>
        <span aria-hidden="true">/</span>
        <a href={`/blog/categories/${catSlug(post.data.category)}`} class="text-muted hover:text-accent transition-colors duration-200">
          {post.data.category}
        </a>
      </nav>
      <h1 data-words class="font-display font-semibold text-[2.1rem] sm:text-[3.1rem] leading-[1.04] text-balance">
        {post.data.title}
      </h1>
      <p class="reveal step-2 mt-6 text-[1.08rem] leading-relaxed text-muted max-w-[52ch]">
        {metaDescription(post.data.description, post.body)}
      </p>
      <dl class="reveal step-3 mt-8 pt-4 border-t border-hair flex flex-wrap items-baseline gap-x-8 gap-y-2 label">
        <div class="flex items-baseline gap-2">
          <dt class="sr-only">Author</dt><dd class="text-muted">Prabhash Jha</dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="sr-only">Published</dt>
          <dd><time datetime={post.data.pubDate}>{fmt(post.data.pubDate)}</time></dd>
        </div>
        <div class="flex items-baseline gap-2">
          <dt class="sr-only">Reading time</dt><dd class="tabular">{mins} min read</dd>
        </div>
      </dl>
    </header>

    {post.data.cover && (
      <div class="mx-auto max-w-4xl px-5 sm:px-8 mt-12">
        <div data-parallax class="frame border border-hair">
          <img
            src={post.data.cover}
            alt=""
            transition:name={`cover-${post.data.slug ?? post.id}`}
            width={coverSize(post.data).width}
            height={coverSize(post.data).height}
            fetchpriority="high"
            class="w-full aspect-[16/9] object-cover"
          />
        </div>
      </div>
    )}

    <div class="mx-auto max-w-3xl px-5 sm:px-8 mt-14">
      <div class="prose-pj reveal"><Content /></div>
    </div>
  </article>

  <Comments />

  <section data-pagefind-ignore class="mx-auto max-w-6xl px-5 sm:px-8 mt-24 md:mt-28">
    <h2 data-lines class="font-display font-semibold text-[1.6rem] sm:text-[2rem] leading-none pb-5 border-b border-hair">
      Keep reading
    </h2>
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-3 pt-8">
      {
        all.map((p) => (
          <a href={`/post/${p.data.slug ?? p.id}`} class="reveal group block">
            {p.data.cover && (
              <div class="frame border border-hair mb-4">
                <img
                  src={p.data.cover}
                  alt=""
                  loading="lazy"
                  width={coverSize(p.data).width} height={coverSize(p.data).height}
                  class="w-full aspect-[16/10] object-cover"
                />
              </div>
            )}
            <p class="label mb-2">{p.data.category}</p>
            <h3 class="font-display font-semibold leading-snug text-[1.08rem] text-balance transition-colors duration-200 group-hover:text-accent">
              {p.data.title}
            </h3>
          </a>
        ))
      }
    </div>
  </section>
</Base>
