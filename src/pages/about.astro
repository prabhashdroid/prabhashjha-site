---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { getEntry, render } from "astro:content";
import { SOCIAL } from "../siteData";
const page = await getEntry("pages", "about");
const d = page!.data;
const { Content } = await render(page!);
---
<Base title={d.title} description={d.description}>
  <section class="relative">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pt-20 pb-14 md:pt-28" data-hero>
      <p class="reveal step-1 label mb-6">/ {d.eyebrow}</p>
      <div class="md:flex md:items-end md:gap-12">
        <div class="flex-1">
          <h1 data-words class="font-display font-semibold text-[2.6rem] sm:text-[3.6rem] leading-[1.03]">
            {d.heading} <span class="grad-text">{d.headingAccent}</span>
          </h1>
        </div>
        {/* A plain rectangular portrait, ruled like every other image on the
            site — a headshot in a circle with a glow behind it belongs to a
            different, glossier kind of site than this one. */}
        <div class="reveal step-2 mt-10 md:mt-0 shrink-0">
          <img src={d.portrait} width="460" height="460"
            alt={d.portraitAlt}
            class="w-[190px] h-[228px] sm:w-[230px] sm:h-[276px] object-cover object-top border border-hair" />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 sm:px-8 pb-24">
    <div class="prose-pj reveal"><Content /></div>

    <div class="mt-14"><ContactForm /></div>
  </section>
</Base>
