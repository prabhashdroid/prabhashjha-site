---
import { coverSize } from "../../seo";
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft && (p.data.slug ?? p.id) !== "privacy-policy")
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base
  title="Topics — Prabhash Jha"
  description="Every practical guide, framework and playbook — marketing, performance, brand, business and AI."
>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pt-20 pb-10 md:pt-28" data-hero>
    <h1 data-words class="t-d2 font-display font-semibold max-w-[10ch]">
      Everything, in one place.
    </h1>
    <p class="reveal step-1 mt-5 text-muted max-w-[39ch] leading-relaxed">
      {posts.length} practical guides on marketing, business and AI. No fluff, no theory for its own sake.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-24">
    {/* Wired's story-row pattern: one column, hairline dividers, image kept
        small and to the side. A grid of cards reads as a product listing;
        a ruled stack reads as a publication — which is what this is. */}
    <div class="max-w-4xl">
      {
        posts.map((p) => (
          <a
            href={`/post/${p.data.slug ?? p.id}`}
            class="reveal rule-draw group grid grid-cols-[1fr] sm:grid-cols-[1fr_11rem] gap-5 sm:gap-8 items-start
                   border-t border-hair py-7 transition-colors duration-200 hover:bg-surface"
          >
            <div>
              <p class="label mb-2">
                <time datetime={p.data.pubDate}>{fmt(p.data.pubDate)}</time>
                <span class="mx-2 opacity-40">/</span>
                {p.data.category}
              </p>
              <h2 class="shift font-display font-semibold text-[1.35rem] sm:text-[1.5rem] leading-[1.15] mb-2 text-balance group-hover:text-accent">
                {p.data.title}
              </h2>
              <p class="text-[0.95rem] text-muted leading-relaxed max-w-[39ch] line-clamp-2">
                {p.data.description}
              </p>
            </div>
            {p.data.cover && (
              <div class="frame order-first sm:order-none border border-hair">
                <img
                  src={p.data.cover}
                  alt=""
                  loading="lazy"
                  transition:name={`cover-${p.data.slug ?? p.id}`}
                  width={coverSize(p.data).width}
                  height={coverSize(p.data).height}
                  class="w-full aspect-[16/10] object-cover"
                />
              </div>
            )}
          </a>
        ))
      }
    </div>
  </section>
</Base>
