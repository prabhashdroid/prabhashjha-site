---
import { coverSize } from "../../../seo";
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { catSlug, CATEGORY_BLURBS } from "../../../categories";
import { TOPICS } from "../../../siteData";

export async function getStaticPaths() {
  const all = (await getCollection("posts")).filter(
    (p) => !p.data.draft && (p.data.slug ?? p.id) !== "privacy-policy"
  );
  const cats = [...new Set(all.map((p) => p.data.category))] as string[];
  return cats.map((c) => ({
    params: { category: catSlug(c) },
    props: {
      category: c,
      posts: all
        .filter((p) => p.data.category === c)
        .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate)),
    },
  }));
}
type Props = { category: string; posts: CollectionEntry<"posts">[] };
const { category, posts } = Astro.props as Props;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

const url = `https://www.prabhashjha.com/blog/categories/${catSlug(category)}/`;
const topicKeywords = ((TOPICS.find((t: any) => t.name === category) as any)?.keywords ?? []) as string[];
const collectionSchema = {
  "@type": "CollectionPage",
  "@id": url + "#collection",
  name: `${category} — Prabhash Jha`,
  description: CATEGORY_BLURBS[category] ?? `Practical guides on ${category}.`,
  url,
  keywords: topicKeywords.join(", "),
  isPartOf: { "@id": "https://www.prabhashjha.com/#website" },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.prabhashjha.com/" },
      { "@type": "ListItem", position: 2, name: "Topics", item: "https://www.prabhashjha.com/blog/" },
      { "@type": "ListItem", position: 3, name: category, item: url },
    ],
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      "@type": "ListItem", position: i + 1, name: p.data.title,
      url: `https://www.prabhashjha.com/post/${p.data.slug ?? p.id}/`,
    })),
  },
};
---
<Base title={`${category} — Prabhash Jha`} description={CATEGORY_BLURBS[category] ?? `Practical guides on ${category}.`}
  article={collectionSchema}
  keywords={topicKeywords}>
  <section class="relative">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-20 pb-10 md:pt-28" data-hero>
      <nav aria-label="Breadcrumb" class="reveal step-1 label flex items-center gap-2 mb-6">
        <a href="/blog" class="inline-flex items-center min-h-[24px] hover:text-accent transition-colors duration-200">Topics</a>
        <span aria-hidden="true">/</span><span class="text-muted">{category}</span>
      </nav>
      <h1 data-words class="t-d2 font-display font-semibold">{category}</h1>
      <p class="reveal step-2 mt-5 text-[1.06rem] text-muted max-w-[37ch] leading-relaxed">{CATEGORY_BLURBS[category]}</p>
      <p class="reveal step-3 label tabular mt-7 pt-4 border-t border-hair">{posts.length} guides</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 sm:px-8 pb-24">
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/post/${p.data.slug ?? p.id}`} class="reveal group block">
          {p.data.cover && (
            <div class="frame border border-hair mb-4">
              <img src={p.data.cover} alt="" loading="lazy" transition:name={`cover-${p.data.slug ?? p.id}`}
                width={coverSize(p.data).width} height={coverSize(p.data).height}
                class="w-full aspect-[16/10] object-cover" />
            </div>
          )}
          <p class="label mb-2"><time datetime={String(p.data.pubDate)}>{fmt(p.data.pubDate)}</time></p>
          <h2 class="font-display font-semibold text-[1.14rem] leading-snug mb-2 text-balance transition-colors duration-200 group-hover:text-accent">{p.data.title}</h2>
          <p class="text-[0.9rem] text-muted leading-relaxed line-clamp-2">{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
