---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Prabhash Jha" description="That page doesn't exist.">
  <section class="relative min-h-[62vh] flex items-center">
    <div class="absolute inset-0 grid-bg" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8 py-24">
      <p class="label mb-5">/ 404</p>
      <h1 class="font-display font-semibold text-[3rem] sm:text-[4.5rem] leading-none max-w-[14ch]">
        This page <span class="grad-text">doesn't exist</span>.
      </h1>
      <p class="mt-6 text-muted max-w-[46ch] leading-relaxed">
        The link may be old, or I may have moved something.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/blog" class="group inline-flex items-center gap-2.5 px-7 py-3.5 font-medium bg-accent text-void border border-accent transition-colors duration-200 hover:bg-transparent hover:text-accent">
          Browse all topics
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
        <a href="/" class="text-[0.95rem] text-muted underline decoration-hair hover:decoration-accent hover:text-text underline-offset-[5px] transition-colors duration-200">Go home</a>
      </div>
    </div>
  </section>
</Base>
