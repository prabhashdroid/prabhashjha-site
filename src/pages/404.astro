---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Prabhash Jha" description="That page doesn't exist.">
  <section class="relative overflow-hidden min-h-[62vh] grid place-items-center">
    <div class="absolute inset-0 grid-bg"></div>
    <div class="orb orb-a w-[26rem] h-[26rem] bg-violet/25 -top-24 left-1/3"></div>
    <div class="relative text-center px-5">
      <p class="font-mono text-[0.7rem] tracking-[0.2em] uppercase text-dim mb-5">/ 404</p>
      <h1 class="font-display font-bold text-[3rem] sm:text-[4.5rem] leading-none">
        This page <span class="grad-text">doesn't exist</span>.
      </h1>
      <p class="mt-6 text-muted">The link may be old, or I may have moved something.</p>
      <div class="mt-9 flex flex-wrap gap-3 justify-center">
        <a href="/blog" class="group relative inline-flex items-center gap-2 rounded-full px-8 py-4 font-medium text-white overflow-hidden transition-transform duration-500 hover:-translate-y-0.5">
          <span class="absolute inset-0 bg-gradient-to-r from-blue via-violet to-cyan"></span>
          <span class="relative">Browse all topics</span>
        </a>
        <a href="/" class="glass glow-hover rounded-full px-8 py-4">Go home</a>
      </div>
    </div>
  </section>
</Base>
