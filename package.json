{
  "name": "prabhashjha-site",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-posts.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "cms": "KEYSTATIC=1 astro dev --port 4322   # (broken upstream - use `npm run admin`)",
    "check": "astro check",
    "admin": "npx --yes concurrently -k -n cms,site -c magenta,cyan \"npx --yes decap-server\" \"node scripts/local-admin.mjs && astro dev --port 4321\"",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.3",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.3.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.4",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^5.6.1",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "concurrently": "^10.0.4",
    "decap-server": "^3.10.0",
    "lighthouse": "^13.4.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  }
}